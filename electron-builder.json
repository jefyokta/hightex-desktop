{
  "$schema": "https://json.schemastore.org/electron-builder",
  "appId": "com.hightex.app",
  "productName": "HighTex",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": ["dist", "dist-electron"],
  "extraResources": [
    {
      "from": "public.key",
      "to": "public.key"
    }
  ],

  "mac": {
    "target": ["dmg"],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
    "icon": "dist/hightex.icns",

    "fileAssociations": [
      {
        "ext": "hightex",
        "name": "HighTex Dynamic Document",
        "role": "Editor"
      },
      {
        "ext": "htx",
        "name": "HighTex Snapshot Document",
        "role": "Viewer"
      }
    ]
  },

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "icon": "dist/hightex.ico",

    "fileAssociations": [
      {
        "ext": "hightex",
        "name": "HighTex Dynamic Document"
      },
      {
        "ext": "htx",
        "name": "HighTex Snapshot Document",
        "role": "Viewer"
      }
    ]
  },

  "linux": {
    "target": ["AppImage"],
    "artifactName": "${productName}-Linux-${version}.${ext}",

    "fileAssociations": [
      {
        "ext": "hightex",
        "name": "HighTex Dynamic Document"
      },
      {
        "ext": "htx",
        "name": "HighTex Snapshot Document",
        "role": "Viewer"
      }
    ]
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
