{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.hightex.app",
  "productName": "HighTex",
  "asar": true,

  "directories": {
    "output": "release/${version}"
  },

  "files": [
    "dist",
    "dist-electron"
  ],

  "mac": {
    "target": ["dmg"],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
    "icon": "dist/hightex.icns",

    "fileAssociations": [
      {
        "ext": "hightex",
        "name": "HighTex Dynamic Document",
        "role": "Editor"
      },
      {
        "ext": "ht",
        "name": "HighTex Document JSON",
        "role": "Editor"
      },
      {
        "ext": "htx",
        "name": "HighTex JSON HT",
        "role": "Editor"
      }
    ]
  },

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "icon": "dist/hightex.ico",

    "fileAssociations": [
      {
        "ext": "hightex",
        "name": "HighTex Dynamic Document"
      },
      {
        "ext": "ht",
        "name": "HighTex Document JSON"
      },
      {
        "ext": "htx",
        "name": "HighTex JSON HT"
      }
    ]
  },

  "linux": {
    "target": ["AppImage"],
    "artifactName": "${productName}-Linux-${version}.${ext}",

    "fileAssociations": [
      {
        "ext": "hightex",
        "name": "HighTex Dynamic Document"
      },
      {
        "ext": "ht",
        "name": "HighTex Document JSON"
      },
      {
        "ext": "htx",
        "name": "HighTex JSON HT"
      }
    ]
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}