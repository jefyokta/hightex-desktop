{
    "name": "hightex-desktop",
    "private": true,
    "version": "0.4.1",
    "type": "module",
    "author": {
        "name": "Jefy okta",
        "email": "jefyokta@gmail.com"
    },
    "scripts": {
        "dev": "vite",
        "build:mac": "tsc && vite build && cp hightex.icns dist/hightex.icns && electron-builder --publish never",
        "build:win": "tsc && vite build && bunx shx cp electron-vite.ico dist/hightex.ico && electron-builder --publish never",
        "build:linux": "tsc && vite build && electron-builder --publish never",
        "publish:mac": "tsc && vite build && cp hightex.icns dist/hightex.icns && electron-builder --mac --publish always",
        "publish:win": "tsc && vite build && bunx shx cp electron-vite.ico dist/hightex.ico && electron-builder --win --publish always",
        "publish:linux": "tsc && vite build && electron-builder --linux --publish always",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "bun test",
        "prettier": "bunx prettier . --write",
        "build:plugin": "bun build electron/plugins/default/reference/index.ts --outdir=electron/plugins/default/reference/ && bun build electron/plugins/default/text-lint/index.ts --outdir=electron/plugins/default/text-lint/ && bun build electron/plugins/default/abstract/index.ts --outdir=electron/plugins/default/abstract/",
        "sign:plugin": "bun signer.ts"
    },
    "dependencies": {
        "@base-ui-components/react": "^1.0.0-rc.0",
        "@floating-ui/react": "^0.27.20",
        "@fontsource-variable/geist": "^5.2.9",
        "@tailwindcss/vite": "^4.3.2",
        "@tippyjs/react": "^4.2.6",
        "@tiptap/core": "^3.27.3",
        "@tiptap/extension-code-block": "^3.27.3",
        "@tiptap/extension-code-block-lowlight": "^3.27.3",
        "@tiptap/extension-collaboration": "^3.27.3",
        "@tiptap/extension-drag-handle-react": "^3.27.3",
        "@tiptap/extension-dropcursor": "^3.27.3",
        "@tiptap/extension-floating-menu": "^3.27.3",
        "@tiptap/extension-history": "^3.27.3",
        "@tiptap/extension-image": "^3.27.3",
        "@tiptap/extension-list": "^3.27.3",
        "@tiptap/extension-paragraph": "^3.27.3",
        "@tiptap/extension-strike": "^3.27.3",
        "@tiptap/extension-subscript": "^3.27.3",
        "@tiptap/extension-superscript": "^3.27.3",
        "@tiptap/extension-table": "^3.27.3",
        "@tiptap/extension-table-cell": "^3.27.3",
        "@tiptap/extension-table-header": "^3.27.3",
        "@tiptap/extension-table-row": "^3.27.3",
        "@tiptap/extension-text": "^3.27.3",
        "@tiptap/extension-underline": "^3.27.3",
        "@tiptap/extensions": "^3.27.3",
        "@tiptap/pm": "^3.27.3",
        "@tiptap/react": "^3.27.3",
        "@tiptap/starter-kit": "^3.27.3",
        "@tiptap/suggestion": "^3.27.3",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.9.5",
        "@types/node-wifi": "^2.0.2",
