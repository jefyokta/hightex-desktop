        "electron-build": "^0.0.3",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.8.9",
        "fflate": "^0.8.3",
        "hast-util-to-html": "^9.0.5",
        "katex": "^0.16.47",
        "lowlight": "^3.3.0",
        "lucide-react": "^1.24.0",
        "mime-types": "^3.0.2",
        "motion": "^12.42.2",
        "next-themes": "^0.4.6",
        "node-wifi": "^2.0.16",
