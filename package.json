    "@tippyjs/react": "^4.2.6",
    "@tiptap/core": "^3.12.1",
    "@tiptap/extension-code-block": "^3.12.1",
    "@tiptap/extension-code-block-lowlight": "3.23.1",
    "@tiptap/extension-collaboration": "3.12.1",
    "@tiptap/extension-drag-handle-react": "^3.12.1",
    "@tiptap/extension-dropcursor": "^3.12.1",
    "@tiptap/extension-floating-menu": "^3.12.1",
    "@tiptap/extension-history": "^3.22.5",
    "@tiptap/extension-image": "^3.12.1",
    "@tiptap/extension-list": "3.12.1",
    "@tiptap/extension-paragraph": "^3.22.5",
    "@tiptap/extension-strike": "^3.12.1",
    "@tiptap/extension-subscript": "^3.12.1",
    "@tiptap/extension-superscript": "^3.12.1",
