    "scripts": {
        "dev": "bun vite",
        "build:mac": "bun run  && tsc && vite build && cp hightex.icns dist/hightex.icns && electron-builder --publish never",
        "build:win": "bun run  && tsc && vite build && bunx shx cp electron-vite.ico dist/hightex.ico && electron-builder --publish never",
        "build:linux": "bun run  && tsc && vite build && electron-builder --publish never",
        "publish:mac": "bun run  && tsc && vite build && cp hightex.icns dist/hightex.icns && electron-builder --mac --publish always",
        "publish:win": "bun run  && tsc && vite build && bunx shx cp electron-vite.ico dist/hightex.ico && electron-builder --win --publish always",
        "publish:linux": "bun run  && tsc && vite build && electron-builder --linux --publish always",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "bun run  && bun test ./tests",
        "prettier": "bunx prettier . --write"
    },
