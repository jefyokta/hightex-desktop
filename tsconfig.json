{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["bun"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@main/*": ["./electron/*"],
      "pagedjs": ["./src/types/pagedjs"],
        "prosemirror-model": ["./node_modules/prosemirror-model"],
  "prosemirror-state": ["./node_modules/prosemirror-state"],
  "prosemirror-transform": ["./node_modules/prosemirror-transform"],
  "prosemirror-view": ["./node_modules/prosemirror-view"]
    }
  },
  "include": [
    "src",
    "electron",
    "src/types/**/*.d.ts",
    "src/components/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["electron/plugins/plugin-example.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
